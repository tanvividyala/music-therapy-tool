# Copy this file to .env and fill in your own values. Never commit .env.
# Leave a value blank if you don't have it yet; the notebook skips that source.

# Spotify: https://developer.spotify.com/dashboard  (FR-1, FR-5)
# Redirect URI must match the dashboard exactly, e.g. http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Genius (lyrics via lyricsgenius): https://genius.com/api-clients
# Use the "Client Access Token".
GENIUS_ACCESS_TOKEN=

# GetSongBPM (BPM fallback): https://getsongbpm.com/api
GETSONGBPM_API_KEY=

# Kaggle (downloads the MuSe CSV): kaggle.com > Settings > API > Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# ReccoBeats (BPM) needs no key.
